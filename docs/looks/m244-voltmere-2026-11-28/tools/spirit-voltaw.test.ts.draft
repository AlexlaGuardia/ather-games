// BETA M244 sheet 17: Voltmere's four AWAKENED forms (owner preview). Run: npx tsx src/app/shimmer/open/ather/spirit-voltaw.test.ts
import { existsSync, readFileSync, statSync } from 'node:fs'
import { AWAKENED_FORMS, VOLTMERE_AWAKENED, VOLTMERE_AW_DIAL, SECOND_FORMS, formGrow } from './spirit-models'
import { AWAKENED_BRANCHES, AWAKENED_NAMES } from '../../spirits/spirit'
import { PUBLIC_FORMS } from './spirit-public'
import { GALLERY } from '../../dev/editors/spirit-gallery'
let pass = 0; const fails: string[] = []
const ok = (c: boolean, m: string) => { if (c) pass++; else fails.push(m) }
const CANON = '/root/athernyx/CANON/world/spirits-species.md', DIR = 'docs/looks/m244-voltmere-2026-11-28'
// names: word for word off the canon line 'Voltmere (Storm): Voltmerkor . Voltmeraya . Voltvis (Ace, pure) . Voltmeth'
const line = existsSync(CANON) ? readFileSync(CANON, 'utf8').split('\n').find(x => x.includes('**Voltmere (Storm):**')) ?? '' : ''
const canon = line.replace(/.*\*\*Voltmere \(Storm\):\*\*/, '').replace(/\*|\([^)]*\)/g, '').split('·').map(x => x.trim())
const named = AWAKENED_BRANCHES.map(b => AWAKENED_NAMES.voltmere?.[b] ?? '')
ok(canon.length === 4 && named.join() === canon.join(), `AWAKENED_NAMES.voltmere = the canon line in branch order (${named} vs ${canon})`)
const looks = named.map(n => n.toLowerCase())
ok(looks.every(n => AWAKENED_FORMS[n] === VOLTMERE_AWAKENED[n]) && Object.keys(VOLTMERE_AWAKENED).sort().join() === [...looks].sort().join(), `each wired once into AWAKENED_FORMS (${Object.keys(VOLTMERE_AWAKENED)})`)
// gallery: four rows, consecutive, turtle + storm
const rows = GALLERY.filter(r => r.aw && r.sp === 'turtle' && r.el === 'storm')
ok(rows.length === 4 && rows.every((r, i) => r.num === rows[0].num + i && r.name === named[i] && r.aw!.look === looks[i]), `Voltmere's four rows in branch order (#${rows.map(r => r.num)}: ${rows.map(r => r.name)})`)
const L3 = '/root/athernyx/assets/stage3/grimoire-ledger-stage3.json'
if (existsSync(L3)) { const locks = JSON.parse(readFileSync(L3, 'utf8')).locks as { name: string; branch_name: string; second_form: string }[]
  for (const r of rows) ok(locks.some(l => l.name === r.name && l.second_form === 'Voltmere' && l.branch_name.toLowerCase() === r.aw!.branch), `${r.name}: a stage-3 lock off Voltmere, ${r.aw!.branch}`) }
const parent = SECOND_FORMS.turtle!.storm!, M: Record<string, any> = {}
for (const n of looks) {
  const L = VOLTMERE_AWAKENED[n], m = M[n] = JSON.parse(readFileSync(`${DIR}/${n}-metrics.json`, 'utf8'))
  ok(L.url === `/open/spirits/${n}-rigged.glb` && existsSync(`public${L.url}`) && statSync(`public${L.url}`).size === m.glb_bytes, `${n}: his glb is in public/ and is the one the metrics measured (${m.glb_bytes} B)`)
  ok(existsSync(`public/open/spirits/${n}-icon.png`), `${n}: gallery icon (our render)`)
  ok(!PUBLIC_FORMS.has(n), `${n}: not in PUBLIC_FORMS (owner preview only)`)
  ok(VOLTMERE_AW_DIAL[n] > formGrow('voltmere') && L.h > parent.h * 1.1, `${n}: grown past Voltmere (dial ${VOLTMERE_AW_DIAL[n]} vs ${formGrow('voltmere')})`)
  ok(L.glow?.part === 'aura' && m.aura_tris > 0, `${n}: the motif (aura part, ${m.aura_tris} tris) glows`)
  ok(Math.abs(L.rig!.glbLen - m.glb_long) < 1e-3, `${n}: glbLen = his metrics (${m.glb_long})`)
  ok(m.body_verts <= 9800, `${n}: body under ~9k verts (${m.body_verts})`)
  // she WALKS: the Shellmere line's own legged rig (18 bones, four legs + feet), NOT Tidemere's glide rig; clips timed at the base's 0.464 m
  ok(m.bones === 18 && m.height_m === 0.464 && Math.abs(L.rig!.clipV.walk - 0.55 / 0.464) < 1e-3 && Math.abs(L.rig!.clipV.run - 1.9 / 0.464) < 1e-3, `${n}: the base Shellmere legged rig (${m.bones} bones), clips at 0.464 m`)
  ok(m.walk.planted_foot_drift_max_m < 0.01 && m.run.planted_foot_drift_max_m < 0.015, `${n}: planted feet hold (walk ${m.walk.planted_foot_drift_max_m} / run ${m.run.planted_foot_drift_max_m} m)`)
  ok(m.all_lowest_with_aura_glb >= 0 && ['idle', 'walk', 'run', 'sit', 'lie'].every(c => m[c].lowest_m > -0.0015), `${n}: body / eyes / aura keep above the ground (lowest ${m.all_lowest_with_aura_glb})`)
  ok(m.quality?.springs?.['walk:head'] > 0.02 && m.quality?.springs?.['walk:tail'] > 0.05, `${n}: baked springs (walk head ${m.quality?.springs?.['walk:head']}, tail ${m.quality?.springs?.['walk:tail']} rad)`)
}
// THE CHAMPION: the biggest, crowned with crystal spikes; the Virtuoso's long neck carries her head high; the Ace low, her jet streaming far behind; the Enigma's storm cloud over her
const rk = M.voltmerkor, ly = M.voltmeraya, vx = M.voltvis, me = M.voltmeth
ok(rk.idle.span_m > Math.max(ly.idle.span_m, vx.idle.span_m, me.idle.span_m) && VOLTMERE_AW_DIAL.voltmerkor >= Math.max(...Object.values(VOLTMERE_AW_DIAL)), `voltmerkor: the biggest (span ${rk.idle.span_m} m, dial ${VOLTMERE_AW_DIAL.voltmerkor})`)
ok(rk.extent_hi[1] > rk.body_mean_top + 0.12 && rk.extent_hi[0] > 0.7, `voltmerkor: the crystal spikes rise over his shell and stand out round his rim (aura top ${rk.extent_hi[1]} vs body ${rk.body_mean_top}, x ${rk.extent_hi[0]})`)
ok(ly.idle.top_m > vx.idle.top_m && ly.extent_hi[2] > vx.extent_hi[2] - 0.05, `voltmeraya: her long neck carries her head high (idle top ${ly.idle.top_m} m vs Voltvis ${vx.idle.top_m})`)
ok(vx.body_mean_top < Math.min(rk.body_mean_top, me.body_mean_top) && vx.extent_lo[2] < -1.2, `voltvis: the low one, her lightning jet streaming far behind (top ${vx.body_mean_top}, back ${vx.extent_lo[2]})`)
ok(me.extent_hi[1] > me.body_mean_top + 0.45, `voltmeth: her own storm cloud rides well over her shell (aura top ${me.extent_hi[1]} vs body ${me.body_mean_top})`)
ok(Object.keys(VOLTMERE_AWAKENED).length === 4, 'four forms')
console.log(`${pass} pass, ${fails.length} fail`); for (const f of fails) console.log('FAIL', f); process.exit(fails.length ? 1 : 0)
