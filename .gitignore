node_modules
.next
.next-*
out
build
.env*
!.env.example
*.log
.DS_Store
next-env.d.ts

# heavy game binary assets — synced separately, not in git
public/spirits
public/characters
public/audio
public/magii
public/manana

# per-game audio beds + VO — server-side only, drop the files, never commit
public/*/music.mp3
public/*/vo/

# arcade leaderboard data (runtime-written)
/data/

# ⚠ ANY sqlite file, ANYWHERE, NOT JUST /data/ — this repo is PUBLIC and `data/accounts.db` holds
# emails and google subject ids. `/data/` covers the real one; it did NOT cover a stray
# `accounts.db` that appeared at the repo root on 2026-08-23 (a mistyped sqlite3 path creates an
# empty file wherever you point it, and sqlite3 never says it did). That one was empty and is gone,
# but the next one might not be, and the failure mode is `git add -A` from any window in a
# four-window swarm publishing user records. Nothing tracked matches this pattern (verified).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# agent worktrees / local claude state — never track
.claude/

.shimmer-backups/
.coord/
__pycache__/

# build cache — regenerated by every `npm run build`, so tracking it means a
# permanently dirty tree and a diff in every commit.
*.tsbuildinfo

# Generated contact sheets — rebuild with `npm run item:art:sheet`, never a source of truth.
item-art.png
icon-sheet.png

# Generated world/canopy shots
canopy*.png
world.png
shots/

# vtuber: the MediaPipe runtime + model are COPIES of an npm dep and a Google-hosted
# model file, not source. `npm run vtuber:assets` puts them in place. Vendored rather
# than CDN-loaded on purpose — a live stream must not depend on someone else's uptime
# at go-live — but a 12MB wasm blob does not belong in this repo's history.
/public/vtuber/wasm/
/public/vtuber/face_landmarker.task

# vtuber: PERSONAL avatar art stays out of this PUBLIC repo. Only `fixture` — the synthetic
# stand-in drawn by scripts/vtuber-fixture.py — is committed. Drop real art in as any other
# name and select it with /vtuber?avatar=<name>; it will never be staged by accident.
# ⚠ On this shared trunk a commit IS a publication decision: any window's push publishes the
# whole branch, so "I'll hold the push" is not a control anyone here actually has.
/public/vtuber/*
!/public/vtuber/fixture*
!/public/vtuber/visemes/
/public/vtuber/visemes/*
!/public/vtuber/visemes/fixture-*
